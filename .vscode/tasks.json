{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "watch",
      "label": "npm: watch",
      "isBackground": true,
      "problemMatcher": "$esbuild-watch",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "never",
        "group": "watch"
      },
      "runOptions": {
        "instanceLimit": 1,
        "instancePolicy": "silent"
      }
    },
    {
      "type": "npm",
      "script": "check-types",
      "label": "npm: check-types",
      "problemMatcher": "$tsc",
      "runOptions": {
        "instanceLimit": 1,
        "instancePolicy": "silent"
      }
    },
    {
      "type": "npm",
      "script": "pretest:integration",
      "label": "npm: pretest:integration",
      "problemMatcher": "$tsc",
      "presentation": {
        "reveal": "silent",
        "group": "watch"
      },
      "runOptions": {
        "instanceLimit": 1,
        "instancePolicy": "silent"
      }
    },
    {
      "label": "Build Extension Tests",
      "dependsOn": [
        "npm: watch",
        "npm: pretest:integration"
      ],
      "dependsOrder": "sequence",
      "runOptions": {
        "instanceLimit": 1,
        "instancePolicy": "silent"
      }
    }
  ]
}
